{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "model_version",
    "model_metadata",
    "generated_at",
    "data_mode",
    "count",
    "universe_count",
    "methodology",
    "research",
    "benchmark_history",
    "hypothetical_basis",
    "portfolio_coverage",
    "market",
    "source_status",
    "run_manifest",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "_comment": "Integer. Readers migrate N->N+1 at load time (src/lib/schemaMigrations.js). Schema 6 is the one renaming exception to additive-only: `confidence` became `data_coverage` and the v2 layers' `confidence` became `evidence_weight_resolved`, because the name asserted reliability that a completeness ratio does not carry. advisorV5ToV6 carries old payloads across; pipeline/migrate_advisor_v2.assert_contract stops a payload being stamped with a version it does not satisfy.",
      "type": "integer",
      "const": 6
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "model_metadata": {
      "type": "object",
      "required": [
        "semantic_version",
        "git_commit_sha",
        "config_hash",
        "generated_at"
      ],
      "properties": {
        "semantic_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "git_commit_sha": {
          "type": "string",
          "minLength": 7
        },
        "config_hash": {
          "type": "string",
          "minLength": 12
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_mode": {
      "const": "live"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "universe_count": {
      "type": "integer",
      "minimum": 20
    },
    "publish_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "research": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "name",
          "score",
          "stance",
          "components",
          "analysis_v2",
          "strengths",
          "risks",
          "history",
          "hypothetical",
          "data_coverage"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "stance": {
            "enum": [
              "ATTRACTIVE",
              "PROMISING",
              "MIXED",
              "CAUTION",
              "INSUFFICIENT DATA"
            ]
          },
          "components": {
            "type": "object",
            "required": [
              "fundamentals",
              "market_behavior",
              "news_sentiment"
            ],
            "properties": {
              "fundamentals": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "market_behavior": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "news_sentiment": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "sentiment_detail": {
            "type": "object",
            "required": [
              "article_count",
              "raw_article_count",
              "coverage",
              "window_days",
              "full_coverage_article_count",
              "syndicated_copies_removed",
              "discarded_low_confidence",
              "weighting_method",
              "articles"
            ],
            "properties": {
              "article_count": {
                "type": "integer",
                "minimum": 0
              },
              "raw_article_count": {
                "type": "integer",
                "minimum": 0
              },
              "coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "window_days": {
                "type": "integer",
                "minimum": 1
              },
              "full_coverage_article_count": {
                "type": "integer",
                "minimum": 6
              },
              "syndicated_copies_removed": {
                "type": "integer",
                "minimum": 0
              },
              "discarded_low_confidence": {
                "type": "integer",
                "minimum": 0
              },
              "weighting_method": {
                "enum": [
                  "recency_source_filing_entity_novelty"
                ]
              },
              "articles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "content_type",
                    "source_quality_tier",
                    "entity_confidence",
                    "composite_weight"
                  ],
                  "properties": {
                    "content_type": {
                      "enum": [
                        "filing",
                        "commentary"
                      ]
                    },
                    "source_quality_tier": {
                      "type": "string"
                    },
                    "entity_confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "composite_weight": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          },
          "recommendation": {
            "type": "object",
            "required": [
              "action",
              "suggested_trim_pct",
              "agreement_count"
            ],
            "properties": {
              "action": {
                "enum": [
                  "HOLD",
                  "WATCH",
                  "TRIM",
                  "SELL"
                ]
              },
              "suggested_trim_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "confidence": {
                "enum": [
                  "moderate",
                  "high"
                ]
              },
              "agreement_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "modifiers": {
            "type": "object",
            "properties": {
              "applied": {
                "type": "object"
              },
              "total": {
                "type": "number",
                "minimum": -15,
                "maximum": 15
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "history": {
            "type": "object",
            "required": [
              "dates",
              "closes",
              "growth"
            ],
            "properties": {
              "dates": {
                "type": "array",
                "minItems": 8,
                "items": {
                  "type": "string"
                }
              },
              "closes": {
                "type": "array",
                "minItems": 8,
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "growth": {
                "type": "array",
                "minItems": 8,
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "analytics_history": {
            "$ref": "#/$defs/analyticsHistory"
          },
          "hypothetical": {
            "type": "object",
            "required": [
              "basis",
              "stock_value",
              "benchmark_value",
              "stock_return_pct",
              "benchmark_return_pct",
              "excess_return_pct",
              "dollars_ahead"
            ],
            "properties": {
              "basis": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "stock_value": {
                "type": "number"
              },
              "benchmark_value": {
                "type": "number"
              },
              "stock_return_pct": {
                "type": "number"
              },
              "benchmark_return_pct": {
                "type": "number"
              },
              "dollars_ahead": {
                "type": "number"
              },
              "excess_return_pct": {
                "type": "number"
              }
            }
          },
          "sector_valuation_percentile": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "analysis_v2": {
            "type": "object",
            "required": [
              "model_version",
              "applicability_profile",
              "structural",
              "timeliness",
              "company_classification",
              "screen_memberships",
              "position_action",
              "metric_status"
            ],
            "properties": {
              "applicability_profile": {
                "type": "string"
              },
              "company_classification": {
                "type": "string"
              },
              "structural": {
                "$ref": "#/$defs/scoreOutput"
              },
              "timeliness": {
                "$ref": "#/$defs/scoreOutput"
              },
              "screen_memberships": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "position_action": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "metric_status": {
                "type": "object"
              }
            }
          },
          "recommendation_v2": {
            "type": "object",
            "description": "Shadow-only decision-v2.0.0 output; legacy recommendation remains active."
          },
          "valuation_percentile": {
            "$ref": "#/$defs/peerPercentile"
          },
          "data_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "_comment": "Share of the evidence this model intended to use that actually resolved. Not a reliability score and not a probability of a price move."
          }
        },
        "additionalProperties": true
      }
    },
    "benchmark_history": {
      "type": "object",
      "required": [
        "symbol",
        "dates",
        "closes",
        "growth"
      ],
      "properties": {
        "symbol": {
          "const": "SPY"
        },
        "dates": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "string"
          }
        },
        "closes": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "growth": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "benchmark_analytics_history": {
      "allOf": [
        { "$ref": "#/$defs/analyticsHistory" },
        {
          "type": "object",
          "properties": { "symbol": { "const": "SPY" } }
        }
      ]
    },
    "hypothetical_basis": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "portfolio_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "name",
          "price"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "methodology": {
      "_comment": "The exact blend is a config decision. What the schema pins is the contract: three components, fundamentals dominant, news a bounded tilt.",
      "type": "object",
      "required": [
        "weights",
        "fundamental_weights"
      ],
      "properties": {
        "weights": {
          "type": "object",
          "required": [
            "fundamentals",
            "market_behavior",
            "news_sentiment"
          ],
          "properties": {
            "fundamentals": {
              "type": "number",
              "minimum": 0.6,
              "maximum": 1.0
            },
            "market_behavior": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 0.3
            },
            "news_sentiment": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 0.15
            }
          }
        },
        "fundamental_weights": {
          "type": "object"
        },
        "market_behavior_weights": {
          "type": "object"
        },
        "news_intelligence": {
          "type": "object"
        },
        "evidence": {
          "type": "object"
        }
      }
    },
    "market": {
      "type": "object",
      "properties": {
        "macro": {
          "type": "object",
          "properties": {
            "regime": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "score",
                "label",
                "coverage",
                "freshness_date",
                "factors",
                "series",
                "attribution",
                "notice",
                "terms_url"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "label": {
                  "enum": [
                    "supportive",
                    "neutral",
                    "restrictive"
                  ]
                },
                "coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "freshness_date": {
                  "type": "string",
                  "format": "date"
                },
                "factors": {
                  "type": "object"
                },
                "series": {
                  "type": "object"
                },
                "attribution": {
                  "type": "string"
                },
                "notice": {
                  "type": "string"
                },
                "terms_url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "source_status": {
      "type": "object"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "theme_screen": {
      "_comment": "Structural-trend exposure, published as an independent screen and never folded into the research score.",
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "unavailable_reason": {
          "type": "string"
        },
        "principle": {
          "type": "string"
        },
        "by_ticker": {
          "type": "object"
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "rows",
              "guardrails"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "guardrails": {
                "type": "object",
                "properties": {
                  "max_price_momentum_contribution": {
                    "const": 0.0
                  }
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "ticker",
                    "theme_exposure_score",
                    "eligible"
                  ],
                  "properties": {
                    "ticker": {
                      "type": "string"
                    },
                    "theme_exposure_score": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 100
                    },
                    "eligible": {
                      "type": "boolean"
                    },
                    "opportunity_score": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "excluded_by": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "candidate_source": {
                      "_comment": "How this row entered theme scoring: already a published leader, a portfolio holding, or a sector/peer-group neighbour of the theme's seed tickers surfaced before it clears the published leaderboard.",
                      "enum": [
                        "published_leader",
                        "portfolio",
                        "sector_peer",
                        null
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "data_freshness": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "error"
          ]
        },
        "stale_count": {
          "type": "integer",
          "minimum": 0
        },
        "stale_after_hours": {
          "type": "number"
        },
        "median_age_hours": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "point_in_time_store": {
      "type": "object",
      "additionalProperties": true
    },
    "cache": {
      "type": "object",
      "additionalProperties": true
    },
    "run_manifest": {
      "type": "object",
      "required": [
        "run_id",
        "generated_at",
        "data_cutoff",
        "code_commit_hash",
        "config_hash",
        "schema_version",
        "model_version",
        "universe_version",
        "provider_status",
        "cache",
        "stale_field_count",
        "provider_conflict_count",
        "score_distribution",
        "rejected_at_each_step"
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "analyticsHistory": {
      "type": "object",
      "required": ["dates", "closes", "frequency"],
      "properties": {
        "symbol": { "type": "string" },
        "dates": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "closes": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "frequency": { "const": "daily" }
      },
      "additionalProperties": false
    },
    "scoreOutput": {
      "type": "object",
      "required": [
        "raw_score",
        "effective_score",
        "coverage",
        "available_weight",
        "applicable_weight",
        "stale_weight",
        "conflicted_weight",
        "missing_metrics",
        "suppressed_metrics",
        "stale_metrics",
        "provider_conflicts",
        "classification",
        "evidence_weight_resolved"
      ],
      "properties": {
        "raw_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "effective_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "available_weight": {
          "type": "number",
          "minimum": 0
        },
        "applicable_weight": {
          "type": "number",
          "minimum": 0
        },
        "stale_weight": {
          "type": "number",
          "minimum": 0
        },
        "conflicted_weight": {
          "type": "number",
          "minimum": 0
        },
        "missing_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suppressed_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stale_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provider_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classification": {
          "type": "string"
        },
        "evidence_weight_resolved": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "peerPercentile": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "display_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 99
        },
        "peer_group_id": {
          "type": "string"
        },
        "peer_count_total": {
          "type": "integer",
          "minimum": 0
        },
        "peer_count_with_valid_data": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_peer_count": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}

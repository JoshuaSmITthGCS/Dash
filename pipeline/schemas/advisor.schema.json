{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "data_mode", "count", "universe_count", "methodology", "research", "benchmark_history", "hypothetical_basis", "portfolio_coverage", "market", "source_status", "disclaimer"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_mode": { "const": "live" },
    "count": { "type": "integer", "minimum": 1, "maximum": 100 },
    "universe_count": { "type": "integer", "minimum": 20 },
    "publish_limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "research": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["ticker", "name", "score", "stance", "confidence", "components", "strengths", "risks", "history", "hypothetical"],
        "properties": {
          "ticker": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "stance": { "enum": ["ATTRACTIVE", "PROMISING", "MIXED", "CAUTION", "INSUFFICIENT DATA"] },
          "components": {
            "type": "object",
            "required": ["fundamentals", "market_behavior", "news_sentiment"],
            "properties": {
              "fundamentals": { "type": "number", "minimum": 0, "maximum": 100 },
              "market_behavior": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "news_sentiment": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "recommendation": {
            "type": "object",
            "required": ["action", "suggested_trim_pct", "agreement_count"],
            "properties": {
              "action": { "enum": ["HOLD", "WATCH", "TRIM", "SELL"] },
              "suggested_trim_pct": { "type": "number", "minimum": 0, "maximum": 100 },
              "confidence": { "enum": ["moderate", "high"] },
              "agreement_count": { "type": "integer", "minimum": 0, "maximum": 3 },
              "reasons": { "type": "array", "items": { "type": "string" } },
              "summary": { "type": "string" }
            }
          },
          "modifiers": {
            "type": "object",
            "properties": {
              "applied": { "type": "object" },
              "total": { "type": "number", "minimum": -15, "maximum": 15 },
              "notes": { "type": "array", "items": { "type": "string" } }
            }
          },
          "history": {
            "type": "object",
            "required": ["dates", "closes", "growth"],
            "properties": {
              "dates": { "type": "array", "minItems": 8, "items": { "type": "string" } },
              "closes": { "type": "array", "minItems": 8, "items": { "type": ["number", "null"] } },
              "growth": { "type": "array", "minItems": 8, "items": { "type": ["number", "null"] } }
            }
          },
          "hypothetical": {
            "type": "object",
            "required": ["basis", "stock_value", "benchmark_value", "stock_return_pct", "benchmark_return_pct", "excess_return_pct", "dollars_ahead"],
            "properties": {
              "basis": { "type": "number", "exclusiveMinimum": 0 },
              "stock_value": { "type": "number" },
              "benchmark_value": { "type": "number" },
              "stock_return_pct": { "type": "number" },
              "benchmark_return_pct": { "type": "number" },
              "dollars_ahead": { "type": "number" },
              "excess_return_pct": { "type": "number" }
            }
          },
          "sector_valuation_percentile": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "strengths": { "type": "array", "items": { "type": "string" } },
          "risks": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "benchmark_history": {
      "type": "object",
      "required": ["symbol", "dates", "closes", "growth"],
      "properties": {
        "symbol": { "const": "SPY" },
        "dates": { "type": "array", "minItems": 8, "items": { "type": "string" } },
        "closes": { "type": "array", "minItems": 8, "items": { "type": ["number", "null"] } },
        "growth": { "type": "array", "minItems": 8, "items": { "type": ["number", "null"] } }
      }
    },
    "hypothetical_basis": { "type": "number", "exclusiveMinimum": 0 },
    "portfolio_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "name", "price"],
        "properties": {
          "ticker": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "price": { "type": ["number", "null"] }
        }
      }
    },
    "methodology": {
      "type": "object",
      "required": ["weights", "fundamental_weights"],
      "properties": {
        "weights": {
          "const": { "fundamentals": 0.75, "market_behavior": 0.15, "news_sentiment": 0.1 }
        }
      }
    },
    "market": {
      "type": "object",
      "properties": {
        "macro": {
          "type": "object",
          "properties": {
            "regime": {
              "type": ["object", "null"],
              "required": ["score", "label", "coverage", "freshness_date", "factors", "series", "attribution", "notice", "terms_url"],
              "properties": {
                "score": { "type": "number", "minimum": 0, "maximum": 100 },
                "label": { "enum": ["supportive", "neutral", "restrictive"] },
                "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
                "freshness_date": { "type": "string", "format": "date" },
                "factors": { "type": "object" },
                "series": { "type": "object" },
                "attribution": { "type": "string" },
                "notice": { "type": "string" },
                "terms_url": { "type": "string", "format": "uri" }
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "source_status": { "type": "object" },
    "disclaimer": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}

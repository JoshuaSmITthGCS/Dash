  "_unusual_timing_comment": "Weights for the composite ranking in political_tracking.unusual_timing(). Four components, each normalized to [0,1] before weighting. A high rank means 'several separately-computable things about this disclosure are unusual at once' - it is not a finding of wrongdoing, and the screen's own copy says so.",
  "unusual_timing": {
    "top_n": 15,
    "size_reference": 500000.0,
    "excess_return_reference": 25.0,
    "filing_delay_reference": 90,
    "news_lookahead_days": 14,
    "weights": {
      "size": 1.0,
      "committee_overlap": 2.0,
      "excess_return": 2.5,
      "filing_delay": 1.0,
      "news_proximity": 1.5
    },
    "minimum_components": 2,
    "max_per_filer": 2
  }

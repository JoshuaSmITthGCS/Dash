      "growth": "equity_broad",
      "value": "equity_broad",
      "small_cap": "equity_broad",
      "dividend": "equity_income",
      "international": "equity_international",
      "sector": "equity_sector",
      "thematic": "equity_thematic",
      "bonds": "fixed_income",
      "commodity": "commodity",
      "crypto": "crypto"
    },
    "disclosure": {
      "_comment": "Optional per-fund Rule 6c-11 endpoint. SEC Rule 6c-11 requires every ETF to publish NAV, market price, premium/discount, and the median 30-day bid-ask spread on a free public website. Issuers publish those under different keys, so declare {url, format, fields} per fund and etf_disclosure.py normalizes it. Funds without an entry fall back to premium/discount computed from quote NAV.",
      "example": {
        "url": "https://issuer.example.com/api/etf/XYZ/6c-11.json",
        "format": "generic_json",
        "fields": {
          "nav": "navPerShare",
          "market_price": "closingPrice",
          "premium_discount_pct": "premiumDiscountPercent",
          "median_bid_ask_spread_pct": "medianSpread30Day",
          "as_of": "asOfDate"
        }
      }
    }
  }

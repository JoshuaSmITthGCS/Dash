{
  "_comment": "All tunable knobs live here. Change weights/thresholds without touching code.",
  "model": {
    "semantic_version": "3.0.0",
    "advisor_schema_version": 3,
    "_comment": "Semantic model and additive advisor artifact schema versions. Every published JSON artifact receives this version plus the producing git SHA, full settings hash, and generation timestamp."
  },
  "normalization_mode": "bands",
  "challengers": {
    "cross_sectional_normalization": {
      "enabled": true,
      "normalization_mode": "cross_sectional",
      "winsor_lower_percentile": 0.01,
      "winsor_upper_percentile": 0.99,
      "sector_minimum_count": 8,
      "largest_movers_count": 20,
      "_comment": "The live champion remains on bands. The challenger fits metric distributions on the complete refreshed universe and publishes beside it."
    },
    "signal_corrections": {
      "enabled": true,
      "short_horizon_treatment": "neutral",
      "reversal_weight": 0.08,
      "shrinkage_target": 50.0,
      "shrinkage_max_pull": 1.0,
      "modifier_cap": 20.0,
      "low_short_interest_percentile": 0.1,
      "short_interest_sector_minimum_count": 8,
      "days_to_cover_penalty_fraction": 0.25,
      "modifier_fractions": {
        "sector_valuation": 0.15,
        "short_interest_penalty": 0.3,
        "short_interest_reward": 0.1,
        "liquidity": 0.15,
        "expectations": 0.15,
        "macro_regime": 0.15,
        "insider_positive": 0.25,
        "insider_negative": 0.15
      },
      "_comment": "The cumulative challenger neutralizes short-horizon relative strength, applies confidence shrinkage once, and expresses every modifier allocation as a fraction of the combined cap."
    }
  },
  "short_horizon_treatment": "legacy_momentum",
  "signal_weights": {
    "track_record": 25,
    "committee_relevance": 20,
    "cluster_detection": 20,
    "trade_size": 15,
    "direction_recency": 10,
    "policy_catalyst": 10
  },
  "cluster": {
    "window_days": 30,
    "min_politicians_for_max": 3
  },
  "recency": {
    "hot_filing_days": 7,
    "warm_filing_days": 30
  },
  "trade_size_bands": {
    "low_max": 15000,
    "mid_max": 100000,
    "high_min": 250000
  },

      "signal": 0.15,
      "valuation": 0.2,
      "stability": 0.65
    }
  },
  "bucket_limits": {
    "short_term": 8,
    "long_term": 8,
    "retirement": 6
  },
  "labels": {
    "_comment": "Composite score -> label. Never 'BUY'. Research candidates only.",
    "high_conviction_min": 75,
    "watch_min": 55,
    "neutral_min": 35
  },
  "feature_flags": {
    "haiku_morning_brief": false,
    "webhook_alerts": false,
    "signal_alert_threshold": 80
  },
  "ranking_weights": {
    "_comment": "Blend of the three evidence components. Fundamentals dominate by design. News sentiment is a 4% tilt rather than a 10% component because headline alpha decays within days (Tetlock 2007); the freed weight went to market behavior, which is now built on 12-1 momentum and real Sharpe/Sortino rather than invented constants.",
    "fundamentals": 0.78,
    "market_behavior": 0.18,
    "news_sentiment": 0.04
  },
  "market_behavior": {
    "_comment": "Market-behavior sub-weights, using the same risk math as the ETF model so a Sharpe means the same thing on both screens. momentum_12_1 skips the most recent month to avoid short-term reversal (Jegadeesh-Titman 1993); low_beta rewards defensive names per betting-against-beta (Frazzini-Pedersen 2014) instead of penalizing volatility with a hand-tuned constant.",
    "weights": {
      "momentum_12_1": 0.3,
      "risk_adjusted": 0.26,
      "relative_strength": 0.16,
      "drawdown_resilience": 0.14,
      "volume_confirmation": 0.08,
      "low_beta": 0.06
    },
    "sentiment_window_days": 7
  }
}

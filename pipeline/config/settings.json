{
  "_comment": "All tunable knobs live here. Change weights/thresholds without touching code.",
  "model": {
    "semantic_version": "3.0.0",
    "advisor_schema_version": 3,
    "_comment": "Semantic model and additive advisor artifact schema versions. Every published JSON artifact receives this version plus the producing git SHA, full settings hash, and generation timestamp."
  },
  "normalization_mode": "bands",
  "challengers": {
    "cross_sectional_normalization": {
      "enabled": true,
      "normalization_mode": "cross_sectional",
      "winsor_lower_percentile": 0.01,
      "winsor_upper_percentile": 0.99,
      "sector_minimum_count": 8,
      "largest_movers_count": 20,
      "own_history_years": 5,
      "own_history_days_per_year": 365,
      "own_history_minimum_observations": 12,
      "_comment": "The live champion remains on bands. The challenger fits metric distributions on the complete refreshed universe and publishes beside it. Valuation own-history percentiles use only prospectively stored observations from the trailing five years and remain unavailable until twelve distinct dated observations exist."
    },
    "signal_corrections": {
      "enabled": true,
      "short_horizon_treatment": "neutral",
      "reversal_weight": 0.08,
      "shrinkage_target": 50.0,
      "shrinkage_max_pull": 1.0,
      "modifier_cap": 20.0,
      "low_short_interest_percentile": 0.1,
      "short_interest_sector_minimum_count": 8,
      "days_to_cover_penalty_fraction": 0.25,
      "modifier_fractions": {
        "sector_valuation": 0.15,
        "short_interest_penalty": 0.3,
        "short_interest_reward": 0.1,
        "liquidity": 0.15,
        "expectations": 0.15,
        "macro_regime": 0.15,
        "insider_positive": 0.25,
        "insider_negative": 0.15
      },
      "_comment": "The cumulative challenger neutralizes short-horizon relative strength, applies confidence shrinkage once, and expresses every modifier allocation as a fraction of the combined cap."
    }
  },
  "short_horizon_treatment": "legacy_momentum",
  "validation": {
    "horizons_days": {
      "1M": 30,
      "3M": 91,
      "6M": 182,
      "12M": 365
    },
    "periods_per_year": 12,
    "minimum_icir_periods": 24,
    "lookahead_rank_ic_threshold": 0.1,
    "confidence_interval_z": 1.96,
    "quantile_counts": [5, 10],
    "long_short_cost_bps": 10.0,
    "shadow_strategy_trials": 5,
    "snapshot_schema_version": 1,
    "modifier_fields": [
      "sector_valuation",
      "short_interest",
      "liquidity",
      "expectations",
      "macro_regime",
      "insider_activity"
    ],
    "_comment": "Prospective point-in-time validation only. Headline statistics stay hidden until the configured monthly history gate is met."
  },
  "position_risk": {
    "atr_multiple_trim": 2.5,
    "atr_multiple_exit": 4.0,
    "atr_lookback_days": 14,
    "sigma_lookback_days": 60,
    "trading_days_per_year": 252,
    "min_stop_distance_pct": 8.0,
    "max_stop_distance_pct": 35.0,
    "fallback_trim_pct": 12.0,
    "fallback_exit_pct": 20.0,
    "_comment": "Position decisions reference the highest observed close since purchase. Cost basis remains display-only."
  },
  "watchlist_setup": {
    "thesis_center": 5.5,
    "thesis_transition_width": 2.0,
    "research_center": 65.0,
    "research_transition_width": 20.0,
    "confidence_center": 0.5,
    "confidence_transition_width": 0.3,
    "transition_slope": 4.0,
    "neutral_subscore": 0.5,
    "hard_confidence_floor": 0.45,
    "weights": {
      "thesis": 0.3,
      "research": 0.3,
      "confidence": 0.2,
      "guidance": 0.2
    },
    "guidance_scores": {
      "HOLD": 1.0,
      "WATCH": 0.6,
      "TRIM": 0.15,
      "SELL": 0.0
    },
    "labels": {
      "strong_min": 75.0,
      "workable_min": 55.0,
      "weak_min": 30.0
    },
    "default_sizing_mode": "capped",
    "minimum_annualized_volatility_pct": 5.0,
    "_comment": "Watchlist quality is a weighted geometric mean of continuous thesis, research, confidence, and published-guidance subscores. Only confidence below the hard floor or a published Sell blocks sizing. Equal-risk sizing scales each name against the calmest covered name and retains the same per-name cap."
  },

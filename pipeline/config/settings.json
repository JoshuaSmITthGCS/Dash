    "largest_sector_warning_pct": 35.0,
    "top_five_warning_pct": 70.0,
    "expected_shortfall_confidence": 0.95,
    "active_share_minimum_coverage_pct": 80.0,
    "factor_minimum_monthly_observations": 24,
    "factor_annualization_months": 12,
    "factor_loading_summary_threshold": 0.15,
    "factor_standard_error_tolerance": 0.000000000001,
    "_comment": "Modified Dietz weights settled external flows by time invested. Correlation analytics use trailing daily total-price returns. The diversification score gives half its weight to effective bets and the diversification ratio, with the other half calibrated from HHI concentration. Performance metric tones use configured good minimums and bad maximums. Values between those boundaries remain neutral, and drawdowns are better when they are closer to zero."
  },
  "etf_lookthrough": {
    "top_holdings_limit": 25,
    "minimum_holding_weight": 0.0001,

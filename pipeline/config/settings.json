        }
      }
    },
    "insider_activity": {
      "_comment": "SEC Form 4 open-market activity scored via the Cohen-Malloy-Pomorski (JF 2012) routine-versus-opportunistic split. Routine calendar-scheduled trades score zero - the paper finds their returns are essentially zero. Opportunistic cluster buys earn up to max_points and decay over one to three months, the horizon the effect pays off over. Sells are capped lower because insiders sell for many non-informative reasons.",
      "max_points": 5.0,
      "max_penalty": 3.0,
      "cluster_bonus": 1.0,
      "min_trade_value": 25000.0
    }
  },
  "bucket_weights": {
    "_comment": "The valuation input is the broad fundamental score (valuation, profitability, health, and growth).",
    "short_term": {
      "signal": 0.7,
      "valuation": 0.15,
      "momentum": 0.15
    },
    "long_term": {
      "signal": 0.4,
      "valuation": 0.45,

      "max_points": 3.0
    },
    "short_interest": {
      "float_warning": 0.08,
      "float_severe": 0.15,
      "days_to_cover_warning": 5.0,
      "max_penalty": 6.0
    },
    "liquidity": {
      "thin_dollar_volume": 25000000,
      "illiquid_dollar_volume": 5000000,
      "max_penalty": 3.0
    },
    "expectations": {
      "max_points": 3.0,
      "strong_upside": 20.0,
      "weak_upside": -5.0,
      "bullish_rating": 2.0,
      "bearish_rating": 3.5
    },
    "macro_regime": {
      "_comment": "FRED-derived context is a sector-sensitive modifier, never a primary ranking factor.",
      "max_points": 3.0,
      "min_coverage": 0.7,
      "sector_weights": {
        "Technology": {

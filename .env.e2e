# Placeholder Firebase config for the Phase 3 Playwright harness build (`vite build --mode e2e`).
# `src/lib/firebase.js` calls getAuth() as a module-load side effect, which throws
# `auth/invalid-api-key` when VITE_FIREBASE_API_KEY is undefined — the production `dist/`
# bundle has never been opened in a real browser before this harness, so nothing previously
# caught that a checkout with no `.env.local` (every CI run, every fresh clone) renders a blank
# page at runtime. These are the exact placeholder values `src/test/setup.js` already uses for
# vitest — never real credentials, only well-formed enough for initializeApp/getAuth to
# construct without throwing. No e2e spec makes a real Firebase network call.
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_STORAGE_BUCKET=test-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:testappid

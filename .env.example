# Copy to .env.local. Never commit the real key.
ALPHA_VANTAGE_API_KEY=replace_me
MARKETAUX_API_TOKEN=replace_me
FRED_API_KEY=replace_me

# SEC EDGAR is free and needs no key, but its fair-access policy requires a real application
# and contact string. Without this the Form 4 insider layer and the theme-exposure screen
# report themselves unavailable rather than spoofing a client.
SEC_USER_AGENT=YourApp research you@example.com

# Optional comma-separated override. Omit to use pipeline/config/advisor_universe.json (120 stocks).
# ADVISOR_SYMBOLS=AAPL,MSFT,GOOGL

# Alpha Vantage enriches at most five; the entire universe still gets scored.
ALPHA_ENRICH_LIMIT=5

# How many of the top candidates get SEC Form 4 insider scoring. Defaults to the publish limit.
# SEC_FORM4_LIMIT=40

# Disable the structural-trend screen entirely (fundamentals scoring is unaffected).
# THEMES_DISABLE=1

# Bypass the on-disk cache and re-download everything. Slow; useful when debugging a provider.
# PIPELINE_CACHE_DISABLE=1

# Firebase Configuration
# Get these from Firebase Console > Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Web Push public application server key. Safe for the browser.
VITE_VAPID_PUBLIC_KEY=replace_with_url_safe_vapid_public_key

# Netlify Functions only — never prefix these with VITE_ or expose them to the browser.
# Fine-grained GitHub token needs Actions: Read and write for this repository.
GITHUB_REFRESH_TOKEN=replace_with_fine_grained_token
REFRESH_GITHUB_REPOSITORY=owner/repository
REFRESH_ALLOWED_EMAILS=approved-user@example.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
VAPID_PUBLIC_KEY=replace_with_url_safe_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:alerts@example.com
ALERT_DELIVERY_SECRET=replace_with_a_long_random_secret

# GitHub Actions uses these two names after every scored refresh. Set the URL to the
# deployed Netlify alert-push function and use the same delivery secret as Netlify.
ALERT_DELIVERY_URL=https://your-site.netlify.app/.netlify/functions/alert-push

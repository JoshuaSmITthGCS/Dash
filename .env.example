# Copy to .env.local. Never commit the real key.
ALPHA_VANTAGE_API_KEY=replace_me
MARKETAUX_API_TOKEN=replace_me
FRED_API_KEY=replace_me

# SEC EDGAR is free and needs no key, but its fair-access policy requires a real application
# and contact string. Without this the Form 4 insider layer and the theme-exposure screen
# report themselves unavailable rather than spoofing a client.
SEC_USER_AGENT=YourApp research you@example.com

# Financial Modeling Prep. Used by pipeline/congress_trades.py for the FMP senate-latest/
# house-latest endpoints and for "since purchase" price history on the Congress trades
# screen. The Congressional endpoints are gated behind a paid FMP plan - a free-tier key
# answers them with HTTP 402, which is a billing boundary, not a bug. The Senate side of
# the screen still gets built without this key (pipeline/congress_trades.py's keyless
# SenateEfdClient reads the Senate's own eFD system directly), and "since purchase" prices
# fall back to the same keyless Yahoo history the rest of this pipeline already uses. House
# trades are also covered without this key, via CONGRESS_HOUSE_DATASET_URL's default
# third-party mirror below - a paid FMP plan is one path to House coverage, not the only one.
# FMP_API_KEY=replace_me

# OpenFIGI. Maps 13F filings' CUSIPs to tickers for the Institutional Accumulation screen
# (pipeline/build_institutional_screen.py). Optional - without it, mapping runs on the
# anonymous tier (10 CUSIPs/request, budget-limited); a free OpenFIGI API key raises that
# to 100/request with no request budget cap, which matters because the mapped universe is
# in the thousands of CUSIPs.
# OPENFIGI_API_KEY=replace_me

# Overrides for pipeline/congress_trades.py's StockWatcherClient, which reads third-party
# mirrors of the House/Senate STOCK Act disclosure datasets. HOUSE_DATASET's default is
# github.com/kadoa-org/congress-trading-monitor's public/data/trades.json - free, keyless,
# actively maintained (daily automated commits as of when this was wired in), and the only
# reachable source of House disclosures this pipeline has; its data is published "for
# research and educational purposes", which matches this screen's own framing. It is still
# a third-party mirror, not an official API, so it carries the same withdrawal risk the
# original stock-watcher mirrors did - set this only to point at a different live mirror in
# the same JSON shape (a flat array of transaction objects; see StockWatcherClient._normalize
# for the field names read). SENATE_DATASET's default (house/senate-stock-watcher-data on
# S3) has been withdrawn and answers every request with HTTP 403 - the Senate side doesn't
# need a working value here since SenateEfdClient already covers it from the authoritative
# source directly; only set this if you want a second Senate source anyway.
# CONGRESS_HOUSE_DATASET_URL=https://example.com/house/all_transactions.json
# CONGRESS_SENATE_DATASET_URL=https://example.com/senate/all_transactions.json

# Optional comma-separated override. Omit to use pipeline/config/advisor_universe.json (910 symbols).
# ADVISOR_SYMBOLS=AAPL,MSFT,GOOGL

# Alpha Vantage enriches at most five; the entire universe still gets scored.
ALPHA_ENRICH_LIMIT=5

# How many of the top candidates get SEC Form 4 insider scoring. Defaults to the publish limit.
# SEC_FORM4_LIMIT=40

# Disable the structural-trend screen entirely (fundamentals scoring is unaffected).
# THEMES_DISABLE=1

# Bypass the on-disk cache and re-download everything. Slow; useful when debugging a provider.
# PIPELINE_CACHE_DISABLE=1

# Firebase Configuration
# Get these from Firebase Console > Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Web Push public application server key. Safe for the browser.
VITE_VAPID_PUBLIC_KEY=replace_with_url_safe_vapid_public_key

# Netlify Functions only — never prefix these with VITE_ or expose them to the browser.
# Fine-grained GitHub token needs Actions: Read and write for this repository.
GITHUB_REFRESH_TOKEN=replace_with_fine_grained_token
REFRESH_GITHUB_REPOSITORY=owner/repository
REFRESH_ALLOWED_EMAILS=approved-user@example.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
VAPID_PUBLIC_KEY=replace_with_url_safe_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:alerts@example.com
ALERT_DELIVERY_SECRET=replace_with_a_long_random_secret

# GitHub Actions uses these two names after every scored refresh. Set the URL to the
# deployed Netlify alert-push function and use the same delivery secret as Netlify.
ALERT_DELIVERY_URL=https://your-site.netlify.app/.netlify/functions/alert-push
